APP_NAME=StartupGraph
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://startupgraph.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production Database (MySQL/PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=startupgraph
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@startupgraph.dev"
MAIL_FROM_NAME="${APP_NAME}"

# AWS/S3 Configuration for file storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin Interface Credentials (HTTP Basic Auth)
# IMPORTANT: Change these values in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# API Keys for data sources (all optional)
# Crunchbase API for discovery of recently funded startups
# Get a key at https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=

# Product Hunt Token for indie project discovery
PRODUCT_HUNT_TOKEN=

# Data Sources
PRODUCTHUNT_TOKEN=
GITHUB_TOKEN=
COMPANIES_HOUSE_KEY=
OPENCORPORATES_KEY=

# Laravel Cloud specific (if needed)
# TELESCOPE_ENABLED=false
# HORIZON_ENABLED=false

# Session and Security Configuration
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Trusted Proxies (Laravel Cloud load balancers)
TRUSTED_PROXIES="*"
TRUSTED_HOSTS="^startupgraph\.dev$"